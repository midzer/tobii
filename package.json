{
  "name": "@midzer/tobii",
  "version": "3.2.1",
  "description": "An accessible, open-source lightbox with no dependencies.",
  "type": "module",
  "main": "./dist/tobii.js",
  "module": "./dist/tobii.module.js",
  "umd:main": "./dist/tobii.umd.js",
  "unpkg": "./dist/tobii.umd.js",
  "source": "./src/js/index.js",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "9.39.2",
    "neostandard": "^0.12.2",
    "rimraf": "4.4.1",
    "rollup": "^4.65.1",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.106.1",
    "stylelint": "^16.26.1"
  },
  "browserslist": {
    "browser": [
      "last 2 versions",
      "not <= 1%"
    ],
    "main": [
      "last 2 versions",
      "not <= 1%"
    ]
  },
  "scripts": {
    "build": "npm run distclean && rollup -c",
    "distclean": "rimraf dist",
    "clean": "rimraf dist && rimraf node_modules",
    "dev": "rollup -c -w",
    "lint": "eslint src",
    "test": "npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/midzer/tobii.git"
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lightbox",
    "accessible",
    "a11y",
    "javascript",
    "vanilla",
    "scss",
    "css"
  ],
  "author": "midzer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/midzer/tobii/issues"
  },
  "homepage": "https://midzer.github.io/tobii/demo/"
}
